{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud/session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm validate:final)",
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm type-check)",
      "Bash(pnpm test:run)",
      "Bash(pnpm check:*)",
      "Bash(pnpm manifest:write)",
      "Bash(pnpm --filter @vintage/api dev:local)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(npx convex deploy*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env.local)"
    ]
  }
}
