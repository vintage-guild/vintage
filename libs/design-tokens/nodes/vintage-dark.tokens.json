{
  "$description": "Member app default: iron surfaces, parchment text, gold accent. People use it at night next to the game.",
  "$extensions": {
    "dev.vintage.node": {
      "name": "vintage-dark",
      "parent": "vintage"
    }
  },
  "semantic": {
    "color": {
      "surface": {
        "canvas": { "$value": "{color.iron.900}" },
        "raised": { "$value": "{color.iron.700}" },
        "sunken": { "$value": "{color.iron.950}" },
        "inverse": { "$value": "{color.parchment.100}" }
      },
      "text": {
        "primary": { "$value": "{color.parchment.100}" },
        "secondary": { "$value": "{color.parchment.400}" },
        "inverse": { "$value": "{color.leather.900}" },
        "accent": { "$value": "{color.gold.300}" }
      },
      "accent": {
        "primary": { "$value": "{color.gold.300}" },
        "contrast": { "$value": "{color.iron.900}" },
        "secondary": { "$value": "{color.crimson.700}" },
        "on-secondary": { "$value": "{color.gold.300}" }
      },
      "border": {
        "default": { "$value": "#f3ead733" },
        "inverse": { "$value": "#2b211833" },
        "strong": { "$value": "{color.iron.300}" }
      },
      "focus": {
        "ring": { "$value": "{color.gold.300}" }
      },
      "feedback": {
        "danger": { "$value": "{color.crimson.300}" },
        "success": { "$value": "#6fcf5a" }
      }
    }
  }
}
