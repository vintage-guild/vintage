{
  "name": "vintage",
  "private": true,
  "type": "module",
  "description": "Guild platform for Vintage on WoW: Forever: raid coordinator, website, loot, and addon on one AFD command surface.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=10.26.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "type-check": "turbo run type-check",
    "test": "vitest",
    "test:run": "vitest run",
    "check:affected": "turbo run type-check build --affected && vitest run --changed origin/main",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:manifest": "pnpm --filter @vintage/api manifest:check",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "check:vendor": "node scripts/check-vendor.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:conflict-markers": "node scripts/check-conflict-markers.mjs",
    "validate:final": "node scripts/run-final-validation.mjs",
    "validate:full": "node scripts/run-final-validation.mjs --full",
    "check": "pnpm validate:full",
    "manifest:write": "pnpm --filter @vintage/api manifest:write",
    "prepare": "node scripts/prepare.mjs",
    "check:scripts": "node --test \"scripts/*.test.mjs\"",
    "tokens:build": "tsx scripts/build-design-tokens.mjs",
    "fixtures:bridge": "tsx scripts/build-bridge-fixtures.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tabler/icons": "^3.35.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "lefthook": "^2.2.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  }
}
