{
  "$description": "Member app default: plum ink surfaces, parchment text, verdigris actions, rose emphasis (home page concept E, 2026-10-25). People use it at night next to the game.",
  "$extensions": {
    "dev.vintage.node": {
      "name": "vintage-dark",
      "parent": "vintage"
    }
  },
  "semantic": {
    "color": {
      "surface": {
        "canvas": { "$value": "{color.plum.950}" },
        "raised": { "$value": "{color.plum.800}" },
        "sunken": { "$value": "{color.plum.975}" },
        "inverse": { "$value": "{color.parchment.100}" }
      },
      "text": {
        "primary": { "$value": "{color.parchment.50}" },
        "secondary": { "$value": "{color.plum.300}" },
        "inverse": { "$value": "{color.leather.900}" },
        "accent": { "$value": "{color.rose.300}" }
      },
      "accent": {
        "primary": { "$value": "{color.verdigris.500}" },
        "contrast": { "$value": "{color.plum.950}" },
        "secondary": { "$value": "{color.gold.500}" },
        "on-secondary": { "$value": "{color.plum.950}" }
      },
      "border": {
        "default": { "$value": "{color.plum.700}" },
        "inverse": { "$value": "#2b211833" },
        "strong": { "$value": "{color.plum.600}" }
      },
      "focus": {
        "ring": { "$value": "{color.verdigris.500}" }
      },
      "feedback": {
        "danger": { "$value": "{color.crimson.300}" },
        "success": { "$value": "#6fcf5a" }
      }
    }
  }
}
