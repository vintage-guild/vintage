{
  "schemaVersion": 1,
  "commands": [
    {
      "name": "character-add",
      "description": "Register one of your characters (main or alt).",
      "tier": "member",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 12,
            "pattern": "^\\p{L}+$"
          },
          "class": {
            "type": "string",
            "enum": [
              "warrior",
              "paladin",
              "hunter",
              "rogue",
              "priest",
              "shaman",
              "mage",
              "warlock",
              "druid"
            ]
          },
          "spec": {
            "type": "string",
            "minLength": 1
          },
          "isMain": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "class",
          "spec"
        ]
      }
    },
    {
      "name": "character-list",
      "description": "Characters for a member (yours by default), or the whole guild for recruits and up.",
      "tier": "member",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string"
          },
          "allGuild": {
            "default": false,
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "character-remove",
      "description": "Remove a character. Shows a preview first; confirm to delete.",
      "tier": "member",
      "mutation": true,
      "destructive": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "characterId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "characterId"
        ]
      }
    },
    {
      "name": "character-update",
      "description": "Change a character’s spec or make it your main.",
      "tier": "member",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "characterId": {
            "type": "string",
            "minLength": 1
          },
          "spec": {
            "type": "string",
            "minLength": 1
          },
          "isMain": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "characterId"
        ]
      }
    },
    {
      "name": "guild-roles-get",
      "description": "The Discord role id → guild rank map that member-sync uses to set rank and tier.",
      "tier": "leader",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "guild-roles-set",
      "description": "Replace the Discord role id → guild rank map. Shows the diff first; confirm to save. Tiers follow at the next role sync.",
      "tier": "officer",
      "mutation": true,
      "destructive": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "roles": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^\\d{17,20}$"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "officer",
                "raid-leader",
                "raider",
                "flex-raider",
                "recruit",
                "member",
                "friend"
              ]
            }
          }
        },
        "required": [
          "roles"
        ]
      }
    },
    {
      "name": "member-list",
      "description": "Guild members with their rank, tier, and main character. Discord-only friends are not listed.",
      "tier": "recruit",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "rank": {
            "type": "string",
            "enum": [
              "officer",
              "raid-leader",
              "raider",
              "flex-raider",
              "recruit",
              "member"
            ]
          }
        }
      }
    },
    {
      "name": "member-me",
      "description": "Your member profile: guild rank, tier, Discord roles, preferences, and characters.",
      "tier": "member",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "member-prefs-set",
      "description": "Update your preferences: DM opt-out, default character, timezone.",
      "tier": "member",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "dmOptOut": {
            "type": "boolean"
          },
          "defaultCharacterId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "member-sync",
      "description": "Sync one member's guild rank and tier from their Discord server membership and roles.",
      "tier": "officer",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "discordId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "inServer": {
            "type": "boolean"
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "discordId",
          "displayName",
          "inServer",
          "roleIds"
        ]
      }
    }
  ]
}
