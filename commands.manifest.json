{
  "schemaVersion": 1,
  "commands": [
    {
      "name": "character-add",
      "description": "Register one of your characters (main or alt).",
      "tier": "member",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^\\p{L}{2,12}( \\p{L}{1,12})?$"
          },
          "class": {
            "type": "string",
            "enum": [
              "warrior",
              "paladin",
              "hunter",
              "rogue",
              "priest",
              "shaman",
              "mage",
              "warlock",
              "druid"
            ]
          },
          "spec": {
            "type": "string",
            "minLength": 1
          },
          "isMain": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "class",
          "spec"
        ]
      }
    },
    {
      "name": "character-list",
      "description": "Characters for a member (yours by default), or the whole guild for recruits and up.",
      "tier": "member",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string"
          },
          "allGuild": {
            "default": false,
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "character-remove",
      "description": "Remove a character. Shows a preview first; confirm to delete.",
      "tier": "member",
      "mutation": true,
      "destructive": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "characterId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "characterId"
        ]
      }
    },
    {
      "name": "character-update",
      "description": "Change a character’s spec or make it your main.",
      "tier": "member",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "characterId": {
            "type": "string",
            "minLength": 1
          },
          "spec": {
            "type": "string",
            "minLength": 1
          },
          "isMain": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "characterId"
        ]
      }
    },
    {
      "name": "comp-suggest",
      "description": "Suggest a raid comp from the signups: who plays, who sits, and what the raid is missing (\"need 1 healer\", \"no Mark of the Wild\"), each with a reason.",
      "tier": "raider",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "eventId"
        ]
      }
    },
    {
      "name": "coordinator-config-set",
      "description": "Set where the coordinator posts (signup and officer channels), whose answers it chases (expectedRanks), and whether it DMs non-responders.",
      "tier": "officer",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "signupChannelId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{17,20}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "opsChannelId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{17,20}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedRanks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "officer",
                "raid-leader",
                "raider",
                "flex-raider",
                "recruit",
                "member",
                "friend"
              ]
            }
          },
          "dmReminders": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "coordinator-log",
      "description": "What the coordinator did for a raid and why: posts, reminders, DMs, locks. Answers 'why did the bot ping me?'.",
      "tier": "member",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "eventId"
        ]
      }
    },
    {
      "name": "coordinator-pause",
      "description": "Stop the coordinator: no posts, reminders, or locks until coordinator-resume.",
      "tier": "leader",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "coordinator-resume",
      "description": "Restart a paused coordinator. Anything that came due while paused goes out on the next tick.",
      "tier": "leader",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "coordinator-run",
      "description": "Run a coordinator tick now instead of waiting for the schedule (it runs every few minutes). Safe to repeat: nothing is sent twice.",
      "tier": "leader",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "coordinator-status",
      "description": "Whether the coordinator is running, its settings, and for each upcoming raid what it has done and what it will do next.",
      "tier": "leader",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "guild-roles-get",
      "description": "The Discord role id → guild rank map that member-sync uses to set rank and tier.",
      "tier": "leader",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "guild-roles-set",
      "description": "Replace the Discord role id → guild rank map. Shows the diff first; confirm to save. Tiers follow at the next role sync.",
      "tier": "officer",
      "mutation": true,
      "destructive": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "roles": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^\\d{17,20}$"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "officer",
                "raid-leader",
                "raider",
                "flex-raider",
                "recruit",
                "member",
                "friend"
              ]
            }
          }
        },
        "required": [
          "roles"
        ]
      }
    },
    {
      "name": "kill-record",
      "description": "Record a boss kill: the raid, the boss (ids from progress-get), when (defaults to now), and what dropped with its quality. The guild’s first kill of a boss is what the ledger shows; later kills are kept as the kill log.",
      "tier": "leader",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "raidId": {
            "type": "string",
            "enum": [
              "barrow-deeps",
              "hyjal-summit",
              "onyxias-lair"
            ]
          },
          "bossId": {
            "type": "string",
            "minLength": 1
          },
          "killedAt": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "loot": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "quality": {
                  "type": "string",
                  "enum": [
                    "poor",
                    "common",
                    "uncommon",
                    "rare",
                    "epic",
                    "legendary"
                  ]
                }
              },
              "required": [
                "name",
                "quality"
              ]
            }
          },
          "note": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "raidId",
          "bossId"
        ]
      }
    },
    {
      "name": "member-list",
      "description": "Guild members with their rank, tier, and main character. Discord-only friends are not listed.",
      "tier": "recruit",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "rank": {
            "type": "string",
            "enum": [
              "officer",
              "raid-leader",
              "raider",
              "flex-raider",
              "recruit",
              "member"
            ]
          }
        }
      }
    },
    {
      "name": "member-me",
      "description": "Your member profile: guild rank, tier, Discord roles, preferences, and characters.",
      "tier": "member",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "member-prefs-set",
      "description": "Update your preferences: DM opt-out, default character, timezone.",
      "tier": "member",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "dmOptOut": {
            "type": "boolean"
          },
          "defaultCharacterId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "member-sync",
      "description": "Sync one member's guild rank and tier from their Discord server membership and roles.",
      "tier": "officer",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "discordId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "inServer": {
            "type": "boolean"
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "discordId",
          "displayName",
          "inServer",
          "roleIds"
        ]
      }
    },
    {
      "name": "progress-get",
      "description": "The progression ledger: the three launch raids, every boss with the guild’s first-kill time (null until it dies), the next target per raid, the totals, and the latest first kill with its loot. Before the raids unlock, `open` is false and every slot is empty. Boss names flagged `datamined` come from the beta client, not from Blizzard.",
      "tier": "member",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "raid-cancel",
      "description": "Cancel a raid. Shows a preview first; confirm to cancel. Signups stay for history.",
      "tier": "leader",
      "mutation": true,
      "destructive": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "eventId"
        ]
      }
    },
    {
      "name": "raid-complete",
      "description": "Mark a raid as done after it started. Records attendance (the roster, or accepted signups when no roster was set) and starts post-raid work.",
      "tier": "leader",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "eventId"
        ]
      }
    },
    {
      "name": "raid-create",
      "description": "Create a one-off raid (not from a schedule), open for signups.",
      "tier": "leader",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "size": {
            "anyOf": [
              {
                "type": "number",
                "const": 10
              },
              {
                "type": "number",
                "const": 20
              },
              {
                "type": "number",
                "const": 40
              }
            ]
          },
          "startsAt": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "durationMinutes": {
            "default": 180,
            "type": "integer",
            "minimum": 30,
            "maximum": 480
          },
          "roleTargets": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "tank": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "healer": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "dps": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "tank",
                  "healer",
                  "dps"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "lootMethodId": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "instance",
          "size",
          "startsAt"
        ]
      }
    },
    {
      "name": "raid-get",
      "description": "One raid with signup counts and your own signup. Recruits and up see the full signup list.",
      "tier": "member",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "eventId"
        ]
      }
    },
    {
      "name": "raid-list",
      "description": "Raids in a time window, soonest first. Defaults to open and locked raids in the next 14 days.",
      "tier": "member",
      "mutation": false,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "from": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "to": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "statuses": {
            "default": [
              "open",
              "locked"
            ],
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "open",
                "locked",
                "cancelled",
                "completed"
              ]
            }
          },
          "scheduleId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "name": "raid-reschedule",
      "description": "Move a raid to a new start time. Signups and roster are kept.",
      "tier": "leader",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "startsAt": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          }
        },
        "required": [
          "eventId",
          "startsAt"
        ]
      }
    },
    {
      "name": "roster-bench",
      "description": "Bench a signed-up character for this raid (they keep their signup).",
      "tier": "leader",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "signupId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "signupId"
        ]
      }
    },
    {
      "name": "roster-lock",
      "description": "Lock signups for a raid; after this only raid leaders can change them.",
      "tier": "leader",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "eventId"
        ]
      }
    },
    {
      "name": "roster-move",
      "description": "Put a signed-up character in a raid group (1–8 for 40s; 5 per group).",
      "tier": "leader",
      "mutation": true,
      "destructive": false,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "signupId": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        },
        "required": [
          "signupId",
          "group"
        ]
      }
    },
    {
      "name": "roster-remove",
      "description": "Remove someone's signup from a raid entirely. Shows a preview first; confirm to remove.",
      "tier": "leader",
      "mutation": true,
      "destructive": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "signupId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
