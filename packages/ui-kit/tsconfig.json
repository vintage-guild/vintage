{
  "extends": "@vintage/config/tsconfig.library.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // FAST's @attr / @observable / @command are legacy decorators, and they install
    // accessors on the prototype that [[Define]] class fields would shadow.
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src"]
}
